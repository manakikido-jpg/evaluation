# Discord Developer Portal で発行した BOT トークン（絶対にコミットしない）
DISCORD_TOKEN=

# PostgreSQL の接続先（docker compose を使う場合はこのままで OK）
DATABASE_URL=postgres://sakura:sakura@db:5432/sakuranomiya

# サーバー内のチャンネル・ロール ID を書いた設定ファイル
GUILD_CONFIG=config/guild.json

# ヘルスチェック用 HTTP ポート（0 で無効）
HEALTH_PORT=8080

# ログレベル（debug / info / warn / error）
LOG_LEVEL=info

# ───── 管理画面（社務所 Web）─────
# Developer Portal → OAuth2 の Client ID と Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 管理画面の URL（Developer Portal の Redirects に「この URL + /auth/callback」を登録する）
WEB_BASE_URL=https://shamusho.example.com
WEB_PORT=3000
# 秘密の入口（https://ドメイン/enter/この文字 からだけログイン画面が開く。16 文字以上の英数字。空なら入口なし）
#   作り方: openssl rand -hex 16
WEB_ENTRY_KEY=
# Discord でのログイン（on で使える。標準は off = 宮司が発行した ID とパスワードだけ）
WEB_DISCORD_LOGIN=off
# 管理画面のドメイン（DNS の A レコードをサーバーの IP に向けておく）
SHAMUSHO_DOMAIN=shamusho.example.com

# 鯖の外のバックアップ（docs/deploy-vps.md の 7）。宮司だけが見られるチャンネルの Webhook の URL と、暗号のあいことば
# BACKUP_WEBHOOK_URL=
# BACKUP_PASSPHRASE=
